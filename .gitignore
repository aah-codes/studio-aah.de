# Betriebssystem
.DS_Store

# Zugangsdaten – nie ins Repository
.env
.env.*
*.key
*.pem
zugangsdaten*
passw*

# Dokumente und Kundendaten – bleiben in iCloud
*.pdf
*.docx
*.xlsx
*.odt

# Sicherungen
*.sql
*.zip

# Interne Doku – bleibt lokal (Original in iCloud), Repository ist öffentlich
doku/

# Python-Zwischenspeicher
__pycache__/

# Ausnahme: öffentliche Download-Dateien für Besucher:innen (Checkliste EU AI Act)
!website/downloads/*.pdf

# Claude Code: nur die Regeln gehören ins Repository, Worktrees und lokale Einstellungen nicht
.claude/worktrees/
.claude/settings.local.json

# Lokale Entwurfsseiten (nur Vorschau, nie veröffentlichen); vorhandene Weiterleitungen bleiben versioniert
website/entwurf-*/
website/service/entwurf-*/
!website/entwurf-ueber-mich/
